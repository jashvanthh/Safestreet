# SafeStreet — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=production

# ── CORS — set to your Render frontend URL ────────────────────────────────────
CLIENT_ORIGIN=https://your-frontend.onrender.com

# ── Email (Gmail SMTP + App Password) ────────────────────────────────────────
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
ADMIN_EMAIL=admin@yourdomain.com
