# Server environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ── MongoDB ─────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/safe-street?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────
PORT=5001
NODE_ENV=development

# ── CORS (set to your frontend URL in production) ──
CLIENT_ORIGIN=http://localhost:5173

# ── Nodemailer (Incident Confirmation, Status Updates & Weekly Digest) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM="SafeStreet Alerts" <your_email@gmail.com>
